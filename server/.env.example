# --- Servidor HablaChat ---

PORT=4000

# Origen del frontend. En produccion: https://tu-app.vercel.app
# Si hay varios origenes separados por coma: https://a.com,https://b.com
CLIENT_ORIGIN=http://localhost:5173

# Ruta del archivo SQLite
DB_PATH=./hablachat.db

# Carpeta de imagenes subidas.
# En Render con disco: /var/data/uploads
UPLOADS_DIR=./uploads

MAX_MESSAGE_LENGTH=1000
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_MESSAGES=5